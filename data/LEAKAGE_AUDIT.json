  "excluded_columns": [
    {
      "column": "nct_id",
      "known_at_start": "yes",
      "reason": "Identifier, kept only to join rows. Carries no information about the outcome."
    },
    {
      "column": "brief_title",
      "known_at_start": "yes",
      "reason": "Free text. Could be used later with text embeddings; not in this simple feature set."
    },
    {
      "column": "overall_status",
      "known_at_start": "label",
      "reason": "The raw status the label comes from (the answer itself)."
    },
    {
      "column": "label",
      "known_at_start": "label",
      "reason": "The target."
    },
    {
      "column": "start_date",
      "known_at_start": "yes",
      "reason": "Used only for the time-based split (via start_year)."
    },
    {
      "column": "start_year",
      "known_at_start": "yes",
      "reason": "Used only for the time-based split. As a feature it can't describe future years the model has never seen."
    },
    {
      "column": "start_date_type",
      "known_at_start": "caution",
      "reason": "Describes the record's format, not the trial: 37% are empty only because the records are old."
    },
    {
      "column": "first_submit_date",
      "known_at_start": "yes",
      "reason": "Used only to drop late registrations. As a feature (registration delay) it leaks: trials registered after they ended are almost all COMPLETED."
    },
    {
      "column": "primary_completion_date",
      "known_at_start": "no",
      "reason": "Known only when the trial ends. Used only to drop late registrations."
    },
    {
      "column": "completion_date",
      "known_at_start": "no",
      "reason": "Known only when the trial ends. Used only as a fallback end date for the late-registration filter."
    },
    {
      "column": "last_update_date",
      "known_at_start": "no",
      "reason": "Known only after the trial: finished trials are updated when they close."
    },
    {
      "column": "why_stopped",
      "known_at_start": "no",
      "reason": "Filled almost only for TERMINATED trials, so it nearly is the label. Used only to flag COVID-terminated trials (data cleaning), never as a feature."
    },
    {
      "column": "has_results",
      "known_at_start": "no",
      "reason": "Results are posted after the trial ends."
    },
    {
      "column": "enrollment_count",
      "known_at_start": "no",
      "reason": "LEAKAGE (reclassified from caution in Phase 8): ~98% of finished trials hold the ACTUAL final number, and trials that stop early enroll fewer people (median 19 vs 60). It would also cause a train/serve mismatch: a live recruiting trial only has the PLANNED number, so the model would be trained on one meaning and used on another."
    },
    {
      "column": "enrollment_type",
      "known_at_start": "no",
      "reason": "ACTUAL or ESTIMATED: says whether the trial has finished, so it is leakage."
    },
    {
      "column": "phases",
      "known_at_start": "yes",
      "reason": "Duplicate of `phase` (same information as a list)."
    },
    {
      "column": "intervention_mesh_terms",
      "known_at_start": "yes",
      "reason": "Thousands of distinct drug/device terms and 45% empty. The intervention types (DRUG, DEVICE, ...) are used instead."
    },
    {
      "column": "lead_sponsor_name",
      "known_at_start": "yes",
      "reason": "About 19,500 distinct names. It would need target encoding, which easily leaks; `lead_sponsor_class` is used instead."
    },
    {
      "column": "conditions",
      "known_at_start": "yes",
      "reason": "Free text as written by the sponsor (thousands of values). Grouped into MeSH disease areas instead."
    },
    {
      "column": "is_fda_regulated_drug",
      "known_at_start": "yes",
      "reason": "DROPPED AFTER AUDIT REVIEW (decided in Phase 8): the field became required for new registrations in 2017, so it is mostly MISSING in the training years (2010-2016) and almost never MISSING afterwards. The model would learn from 'MISSING', a value live trials never have (train/serve mismatch). See section 8 for the measured drift."
    },
    {
      "column": "is_fda_regulated_device",
      "known_at_start": "yes",
      "reason": "DROPPED AFTER AUDIT REVIEW (decided in Phase 8): same 2017 rule change and train/serve mismatch as is_fda_regulated_drug. See section 8."
    }
  ],
